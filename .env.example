# ==============================================================================
# Environment Configuration Template for Docker Microservices Stack
# Copy this file to '.env' and adjust variables as needed.
# ==============================================================================

# Global environments
ENV=development

# API Gateway Config
GATEWAY_PORT=80

# Frontend Port
FRONTEND_PORT=3000

# User Service Settings
USER_SERVICE_PORT=5000

# Catalog Service Settings
CATALOG_SERVICE_PORT=8080

# Order Service Settings
ORDER_SERVICE_PORT=8000

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=devuser
DB_PASSWORD=devpassword
DB_NAME=microservices_db

# MongoDB Configuration
MONGO_URI=mongodb://devuser:devpassword@mongodb:27017/catalog_db?authSource=admin
MONGO_INITDB_ROOT_USERNAME=devuser
MONGO_INITDB_ROOT_PASSWORD=devpassword
MONGO_INITDB_DATABASE=catalog_db

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Monitoring Configurations
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
