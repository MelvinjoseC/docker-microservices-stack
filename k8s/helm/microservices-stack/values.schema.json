{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": [
    "environment",
    "replicaCount",
    "images",
    "ports"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "replicaCount": {
      "type": "object",
      "required": ["gateway", "frontend", "user", "catalog", "order", "notification"],
      "properties": {
        "gateway": { "type": "integer", "minimum": 1 },
        "frontend": { "type": "integer", "minimum": 1 },
        "user": { "type": "integer", "minimum": 1 },
        "catalog": { "type": "integer", "minimum": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "notification": { "type": "integer", "minimum": 1 }
      }
    },
    "ports": {
      "type": "object",
      "properties": {
        "gateway": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "frontend": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "catalog": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "order": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
