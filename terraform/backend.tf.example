# ==============================================================================
# Production Terraform Remote State Configuration (S3 + DynamoDB)
# Rename this file to 'backend.tf' to activate remote state locking
# ==============================================================================

terraform {
  backend "s3" {
    bucket         = "microservices-stack-terraform-state-prod"
    key            = "eks/terraform.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "microservices-stack-tf-lock"
  }
}
